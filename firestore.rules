rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) 
        && data.keys().size() == 2
        && data.email is string && data.email.size() <= 200
        && data.createdAt == request.time;
    }
    
    function isValidUserUpdate(data) {
      return data.keys().hasOnly(['email']) 
        && data.email is string && data.email.size() <= 200;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII isolation - users cannot list all other users
      
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming());
                    
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUserUpdate(incoming().diff(existing()));
                    
      allow delete: if false;
    }
  }
}
